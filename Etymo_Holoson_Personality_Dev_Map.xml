<?xml version="1.0" encoding="UTF-8"?>
<EHPDM version="1.1" lane="Personality" repo="https://github.com/brxyz-world/riva-mic">

  <Principles>
    <RoutingPhilosophy>ACK first → route smart → add flavor</RoutingPhilosophy>
    <Axes>
      <Axis name="Utility"/>
      <Axis name="Personality"/>
      <Axis name="Performance"/>
    </Axes>
    <MemoryTiers>
      <Tier name="Ephemeral" status="active">Short-turn carryover; local thread references.</Tier>
      <Tier name="Personal"  status="planned">Stable user preferences and safe facts.</Tier>
      <Tier name="Cultural"  status="planned">Eddie’s lore, recurring bits, show canon.</Tier>
    </MemoryTiers>
    <LaneDiscipline>No debugging or code in this lane; technical issues live in the Debug Lane.</LaneDiscipline>
  </Principles>

  <Versions>

    <!-- 1.x foundation already achieved -->
    <Version id="1" name="Router Core">
      <Intent>Reliable branching among utility, personality, and fallback with instant ACKs.</Intent>
      <Measures>
        <Metric>ACK latency</Metric><Metric>Route accuracy %</Metric><Metric>User-perceived snappiness</Metric>
      </Measures>
    </Version>

    <!-- 2.x: Personality & Operator Era -->
    <Version id="2" name="Personality & Operator Era">
      <Intent>Establish tone/moods; govern longform; prepare light RAG and tool bridges.</Intent>

      <Subphases>

        <Sub id="2.2.1" name="Moods v1 (operational)"/>
        <Sub id="2.2.2" name="Stand-By + Wake Window"/>

        <Sub id="2.2.3" name="Long-form + Telemetry">
          <release id="2.2.3">
            <summary>Short-form restored; longform test path validated; thinking-beats added.</summary>
          </release>
        </Sub>

        <Sub id="2.2.4" name="Router-Gated Longform">
          <release id="2.2.4">
            <summary>Router-gated longform & smarter TTS; single-print console; mic ready-check (default ON).</summary>
            <features>
              <feature>Story begins only on explicit ask or follow-up on same topic; rare allegory/reflect routes.</feature>
              <feature>Mic-only ready-check with timeout; optional thinking beats when long gen &gt; 8s.</feature>
              <feature>Single console emission for longform; chunker avoids mid-word cuts.</feature>
              <feature>Operator panel file and wake==router troubleshooting note; README links.</feature>
            </features>
            <Measures>
              <Metric>long_form=true on routed story turns; zero false positives on utility prompts.</Metric>
              <Metric>ready_check_ms p95 ≤ 1000; timeout path &lt; 5% longform sessions.</Metric>
              <Metric>Thinking beats on longform gens &gt; 8s; 0 beats in short-form.</Metric>
              <Metric>Exactly one console print per longform turn in smoketest.</Metric>
              <Metric>midword_cut_rate &lt; 5%; spoken_s ≤ MAX_S + 1.0.</Metric>
              <Metric>README links to operator panel (no duplication); “wake==router” note present; links OK.</Metric>
              <Metric>first_audio_ms p95 regression ≤ +100ms vs 2.2.3.</Metric>
              <Metric>Story ≥ 600 chars, ≥ 4 paragraphs, no clipper; LLM latency p95 ≤ 15s at LONGFORM_NUM_PREDICT≈384 (warm).</Metric>
            </Measures>
            <links><link rel="taskcard">CETC-1</link><link rel="streams">1R,1S,1A</link></links>
          </release>

          <!-- Router keys, follow-ups, moods, wake window -->
          <RouterPolicy>
            <Keys>
              <Key id="R_hello"          kind="greeting" setsLongForm="false"/>
              <Key id="R_hush"           kind="utility"  setsLongForm="false"/>
              <Key id="R_exit"           kind="utility"  setsLongForm="false"/>
              <Key id="R_story.begin"    kind="story"    setsLongForm="true"/>
              <Key id="R_story.continue" kind="story"    setsLongForm="true"/>
              <Key id="R_allegory"       kind="story"    setsLongForm="true" rateLimit="1/5turns"/>
              <Key id="R_reflect"        kind="story"    setsLongForm="true" rateLimit="1/5turns"/>
            </Keys>
            <FollowUpPolicy>
              <Trigger phrases="expand|go deeper|tell me more|continue">
                <Route to="R_story.continue"/>
                <TopicConstraint>same-as-previous-reply</TopicConstraint>
              </Trigger>
            </FollowUpPolicy>
            <MoodBiases>
              <PrimaryStoryMood id="Content_Eve"/>
              <Mood id="mood.contemplative"><Bias route="R_reflect"  weight="+0.10"/></Mood>
              <Mood id="mood.playful">      <Bias route="R_allegory" weight="+0.10"/></Mood>
              <Invariants>
                <Rule>Utility keys must always set long_form=false.</Rule>
                <Rule>Wake phrase opens a time-boxed window; does not set long_form.</Rule>
              </Invariants>
            </MoodBiases>
            <WakeWindow defaultSeconds="20">
              <MoodOverride mood="Content_Eve" seconds="30"/>
            </WakeWindow>
          </RouterPolicy>
        </Sub>

        <Sub id="2.3" name="Notification Talk-back"/>
        <Sub id="2.4" name="RAG Minimal"/>
        <Sub id="2.5" name="MCP Thin"/>
        <Sub id="2.6" name="Embodiment Prep (UE lip-sync, gesture palette)"/>

      </Subphases>
    </Version>

    <!-- 3.x: Eddie for The Etymo Show -->
    <Version id="3" name="Eddie for The Etymo Show">
      <Intent>Live Unreal MetaHuman host: show rundown, Twitch chat, b-roll, co-host appearances.</Intent>
      <CheckpointRitual>30–60s cold open in Unreal with chat interjections and camera cuts.</CheckpointRitual>
      <Dependencies>
        <PhaseRef id="2.4"/><PhaseRef id="2.5"/><PhaseRef id="2.6"/>
      </Dependencies>
    </Version>

  </Versions>

  <!-- Task Cards registry -->
  <TaskCards>
    <TaskCard id="CETC-1" name="Longform Mode Switch">
      <Streams>1R,1S,1A</Streams>
      <Releases>
        <ReleaseRef id="2.2.3" note="CETC-1.0"/>
        <ReleaseRef id="2.2.4" note="CETC-1.1 init, 1.2 impl"/>
      </Releases>
    </TaskCard>
    <TaskCard id="CETC-2" name="JSONL Schema Unify"/>
    <TaskCard id="CETC-3" name="Memory Service (min)"/>
    <TaskCard id="CETC-4" name="Capsule Embed Index"/>
    <TaskCard id="CETC-5" name="Orchestrator RAG Inject"/>
    <TaskCard id="CETC-6" name="Test Harness CLI"/>
    <TaskCard id="CETC-7" name="Docs Refresh"/>
  </TaskCards>

</EHPDM>
