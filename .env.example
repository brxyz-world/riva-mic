OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
PORCUPINE_ACCESS_KEY=raplace_with_porcupine_key
PORCUPINE_KEYWORD_PATH=Eddie/config/Hello-Eddie.ppn
EDDIE_WAKEWATCH=1
EDDIE_FORCE_ANSI=1
EDDIE_WARMUP=1
WAKE_PORT=0
OLLAMA_WARMUP_ON_START=0

# .env for long-form testing
LONG_FORM=0
NUM_PREDICT=512
LONGFORM_MIN_CHARS=1200
LONGFORM_TEMPERATURE=0.6
LLM_TIMEOUT_MS=6000
LONGFORM_RETRY=0
LONGFORM_SUGGEST_CONTINUE=1
LONGFORM_REFUSAL_GUARD=1
LONGFORM_REFUSAL_SEED=Okay—starting the story.
LONGFORM_AUTOCONFIRM=1
LONGFORM_AUTOCONFIRM_NUM_PREDICT=768
LONGFORM_AUTOCONFIRM_TIMEOUT_MS=30000
OLLAMA_KEEP_ALIVE=30m
TWF_DISABLE=1
LONGFORM_READY_CHECK=1        # 0=off, 1=ask+autoplay on silence
READY_CHECK_WAIT_MS=2000
READY_CHECK_PROMPT="Alright—ready for the story, or wanna skim it on screen first?"